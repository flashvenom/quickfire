    private async Task RefreshLibraryAsync()
    {
        libraryEntries = await FormsLibraryService.GetLibraryAsync();
        BuildFilterOptions();
        ApplyFilters();
        await InvokeAsync(StateHasChanged);
    }

    private void BuildFilterOptions()
    {
        var carriers = libraryEntries
            .Select(e => e.CarrierName)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct()
            .OrderBy(v => v)
            .ToList();
        var wholesalers = libraryEntries
            .Select(e => e.WholesalerName)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct()
            .OrderBy(v => v)
            .ToList();
        var markets = libraryEntries
            .Select(e => e.MarketTag)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct()
            .OrderBy(v => v)
            .ToList();

        carrierOptions = new List<string> { "All" };
        carrierOptions.AddRange(carriers);
        editCarrierOptions = carriers;

        wholesalerOptions = new List<string> { "All" };
        wholesalerOptions.AddRange(wholesalers);
        editWholesalerOptions = wholesalers;

        marketOptions = new List<string> { "All" };
        marketOptions.AddRange(markets);
        editMarketOptions = markets;
    }

    private void ApplyFilters()
    {
        IEnumerable<FormsLibraryEntry> query = libraryEntries;

        if (!showArchived)
        {
            query = query.Where(e => !e.IsArchived);
        }

        if (onlyBookmarked)
        {
            query = query.Where(e => e.IsBookmarked);
        }

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var needle = searchText.Trim().ToLowerInvariant();
            query = query.Where(e =>
                (e.Title ?? string.Empty).ToLowerInvariant().Contains(needle) ||
                (e.CarrierName ?? string.Empty).ToLowerInvariant().Contains(needle) ||
                (e.WholesalerName ?? string.Empty).ToLowerInvariant().Contains(needle) ||
                (e.MarketTag ?? string.Empty).ToLowerInvariant().Contains(needle));
        }

        if (!string.Equals(selectedCarrier, "All", StringComparison.OrdinalIgnoreCase))
        {
            query = query.Where(e => string.Equals(e.CarrierName, selectedCarrier, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(selectedWholesaler, "All", StringComparison.OrdinalIgnoreCase))
        {
            query = query.Where(e => string.Equals(e.WholesalerName, selectedWholesaler, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(selectedMarket, "All", StringComparison.OrdinalIgnoreCase))
        {
            query = query.Where(e => string.Equals(e.MarketTag, selectedMarket, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(selectedRating, "All", StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(selectedRating, out var ratingFilter))
        {
            query = query.Where(e => (e.Rating ?? 0) >= ratingFilter);
        }

        query = selectedSort switch
        {
            "Rating" => query.OrderByDescending(e => e.Rating ?? 0).ThenBy(e => e.Title ?? string.Empty),
            "Last Updated" => query.OrderByDescending(e => e.DateModified),
            "Title" => query.OrderBy(e => e.Title ?? string.Empty),
            _ => query
                .OrderByDescending(e => e.IsBookmarked)
                .ThenByDescending(e => e.Rating ?? 0)
                .ThenBy(e => e.Title ?? string.Empty)
        };

        filteredEntries = query.ToList();
        EnsureSelectedEntry();
    }

    private Task OnFiltersChanged()
    {
        ApplyFilters();
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnSearchChanged()
    {
        searchDebounceCts?.Cancel();
        searchDebounceCts?.Dispose();
        searchDebounceCts = new CancellationTokenSource();
        var token = searchDebounceCts.Token;

        try
        {
            await Task.Delay(500, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        ApplyFilters();
        await InvokeAsync(StateHasChanged);
    }

    private void EnsureSelectedEntry()
    {
        if (filteredEntries.Count == 0)
        {
            selectedEntry = null;
            return;
        }

        var preferredId = StateService.LastFormsLibraryEntryId ?? selectedEntry?.FormsLibraryEntryId;
        if (preferredId.HasValue)
        {
            selectedEntry = filteredEntries.FirstOrDefault(e => e.FormsLibraryEntryId == preferredId.Value)
                ?? filteredEntries[0];
        }
        else
        {
            selectedEntry = filteredEntries[0];
        }

        StateService.LastFormsLibraryEntryId = selectedEntry.FormsLibraryEntryId;
    }

