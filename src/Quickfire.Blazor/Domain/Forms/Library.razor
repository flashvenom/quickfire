    private async Task<bool> AttachFormToClientAsync(int clientId)
    {
        if (selectedEntry?.ActiveVersion == null)
        {
            ToastService.ShowWarning("Select a form first.");
            return false;
        }

        var sourcePath = FormsLibraryService.ResolveAbsolutePath(selectedEntry.ActiveVersion);
        if (string.IsNullOrWhiteSpace(sourcePath) || !File.Exists(sourcePath))
        {
            ToastService.ShowError("Form file not found.");
            return false;
        }

        try
        {
            var originalName = selectedEntry.ActiveVersion.OriginalFileName
                ?? selectedEntry.Title
                ?? "library-form.pdf";
            var extension = Path.GetExtension(originalName);
            if (string.IsNullOrWhiteSpace(extension))
            {
                extension = ".pdf";
            }

            var safeBaseName = SanitizeFileName(Path.GetFileNameWithoutExtension(originalName));
            var hash = StringHelper.GenerateFiveCharacterHash(safeBaseName);
            var hashedFileName = $"{safeBaseName}_{hash}{extension}";

            var rootPath = Directory.GetCurrentDirectory();
            var uploadsDir = Path.Combine(rootPath, "wwwroot", "uploads", "clients", clientId.ToString());
            Directory.CreateDirectory(uploadsDir);

            var destinationPath = Path.Combine(uploadsDir, hashedFileName);
            File.Copy(sourcePath, destinationPath, true);

            var dataDir = Path.Combine(uploadsDir, ".data");
            Directory.CreateDirectory(dataDir);
            var thumbPath = Path.Combine(dataDir, Path.GetFileNameWithoutExtension(hashedFileName) + "_thumb.jpg");
            try
            {
                await PdfThumbnailGenerator.CreateJpegThumbnailAsync(destinationPath, thumbPath);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Thumbnail generation failed: {ex.Message}");
            }

            var fileInfo = new FileInfo(destinationPath);
            var attachment = new Attachment
            {
                OriginalFileName = originalName,
                HashedFileName = hashedFileName,
                LocalPath = $"uploads/clients/{clientId}",
                FileFormat = extension,
                FileSize = fileInfo.Length,
                DateCreated = DateTime.UtcNow,
                ClientId = clientId,
                Description = GetEntryTitle(selectedEntry)
            };

            await AttachmentService.SaveAttachmentDirectlyAsync(attachment);
            StateService.NotifyAttachmentListUpdated();
            return true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Attach failed: {ex.Message}");
            return false;
        }
    }

