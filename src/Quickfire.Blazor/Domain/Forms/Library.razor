    private string? GetThumbnailUrl(FormsLibraryVersion? version)
    {
        if (version == null ||
            string.IsNullOrWhiteSpace(version.RelativePath) ||
            string.IsNullOrWhiteSpace(version.StoredFileName))
        {
            return null;
        }

        var relativePath = version.RelativePath.Trim('/').Replace("\\", "/");
        var thumbName = Path.GetFileNameWithoutExtension(version.StoredFileName) + "_thumb.jpg";
        return $"/{relativePath}/.data/{thumbName}";
    }

    private string? GetDocumentUrl(FormsLibraryVersion? version)
    {
        if (version == null ||
            string.IsNullOrWhiteSpace(version.RelativePath) ||
            string.IsNullOrWhiteSpace(version.StoredFileName))
        {
            return null;
        }

        var relativePath = version.RelativePath.Trim('/').Replace("\\", "/");
        return $"/{relativePath}/{version.StoredFileName}";
    }

    private string? TryCreateTempAttachmentPath(FormsLibraryVersion version)
    {
        var sourcePath = FormsLibraryService.ResolveAbsolutePath(version);
        if (string.IsNullOrWhiteSpace(sourcePath) || !File.Exists(sourcePath))
        {
            return null;
        }

        try
        {
            var originalName = version.OriginalFileName ?? "library-form.pdf";
            var extension = Path.GetExtension(originalName);
            if (string.IsNullOrWhiteSpace(extension))
            {
                extension = Path.GetExtension(sourcePath);
            }
            if (string.IsNullOrWhiteSpace(extension))
            {
                extension = ".pdf";
            }

            var safeBaseName = SanitizeFileName(Path.GetFileNameWithoutExtension(originalName));
            var hash = StringHelper.GenerateFiveCharacterHash(safeBaseName);
            var tempFileName = $"{safeBaseName}_{hash}{extension}";

            var rootPath = Directory.GetCurrentDirectory();
            var tempFolder = Path.Combine(rootPath, "wwwroot", "uploads", "temp");
            Directory.CreateDirectory(tempFolder);

            var tempPath = Path.Combine(tempFolder, tempFileName);
            File.Copy(sourcePath, tempPath, true);

            var relativeTempPath = Path.Combine("uploads", "temp", tempFileName);
            var attachmentPath = StringHelper.BuildAttachmentFilePath(StateService.FileStorageSettings, relativeTempPath);
            return string.IsNullOrWhiteSpace(attachmentPath) ? null : attachmentPath;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Temp attachment copy failed: {ex.Message}");
            return null;
        }
    }

    private static string SanitizeFileName(string? baseName)
    {
        if (string.IsNullOrWhiteSpace(baseName))
        {
            return "library-form";
        }

        var invalidChars = Path.GetInvalidFileNameChars();
        var cleaned = new string(baseName.Where(ch => !invalidChars.Contains(ch)).ToArray());
        return string.IsNullOrWhiteSpace(cleaned) ? "library-form" : cleaned;
    }

