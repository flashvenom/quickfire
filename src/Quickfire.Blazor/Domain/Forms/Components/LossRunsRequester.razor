    }
    
    .carrier-info {
        display: flex;
        flex-direction: column;
    }

    .carrier-header h4 {
        margin: 0;
        color: var(--accent-foreground-rest);
    }
    
    .carrier-email {
        font-size: 0.9rem;
        color: var(--neutral-foreground-hint);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .carrier-url {
        font-size: 0.9rem;
